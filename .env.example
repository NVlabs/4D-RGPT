# Copy to .env and fill in. `.env` is gitignored.

# SLURM account passed to `scripts/slurm/submit.sh` via the `submit_job` CLI.
# Required for any cluster job. Local-only / single-node use does not need it.
SLURM_ACCOUNT=""

# Root for evaluation/training datasets resolved by data/config.py. Defaults
# to "datasets" (relative to CWD) if unset. Used as a base for dataset paths
# referenced from `data/registry.yaml`.
DATASETS_ROOT=""

# Path to the dataset registry consumed by data/config.py. Defaults to
# data/registry.yaml in-repo. See data/README.md.
REGISTRY_PATH="data/registry.yaml"

# Optional: also consumed by llava/data/builder.py if set, for the legacy
# VILA-style mixture registry under llava/data/registry/.
VILA_DATASETS="data/registry.yaml"

# Hugging Face token — only required to download gated models / datasets.
HF_ACCESS_TOKEN=""
